  %idx = add nsw i64 %mul, %i
  %gep = getelementptr inbounds i64, ptr %a, i64 %idx
  store i64 %j, ptr %gep, align 8
  %j.next = add nuw nsw i64 %j, 1
  %iec = icmp eq i64 %j.next, %bound
  br i1 %iec, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %oec = icmp eq i64 %i.next, %N
  br i1 %oec, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.vectorize.enable"}
!2 = !{!"llvm.loop.vectorize.width", i32 4}

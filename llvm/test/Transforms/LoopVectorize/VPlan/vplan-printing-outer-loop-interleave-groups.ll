; The loads and stores of outer-loop plans, and the interleave groups formed
; from them: full groups of loads or stores in one block whose addresses have a
; constant stride in the vectorized outer loop. The full IR of some groups is
; checked in outer-loop-interleave-groups.ll.

; The loads and the stores are not in address order, so the first load and the
; first store are not member 0 of their groups.
define void @groups_out_of_address_order(ptr noalias %dst, ptr noalias %src, i64 %N, i64 %M) {
; CHECK-LABEL: VPlan for loop in 'groups_out_of_address_order'
; CHECK:      INTERLEAVE-GROUP with factor 3, ir<%p0>
; CHECK:        ir<%v0> = load from index 0
; CHECK:        ir<%v1> = load from index 1
; CHECK:        ir<%v2> = load from index 2
; CHECK:      INTERLEAVE-GROUP with factor 3, ir<%d0>
; CHECK:        store ir<%v1> to index 0
; CHECK:        store ir<%v2> to index 1
; CHECK:        store ir<%v0> to index 2
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner ]
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %M
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %i3 = mul nsw i64 %i, 3
  %p0 = getelementptr inbounds i32, ptr %src, i64 %i3
  %p1 = getelementptr inbounds i8, ptr %p0, i64 4
  %p2 = getelementptr inbounds i8, ptr %p0, i64 8
  %v1 = load i32, ptr %p1, align 4
  %v0 = load i32, ptr %p0, align 4
  %v2 = load i32, ptr %p2, align 4
  %d0 = getelementptr inbounds i32, ptr %dst, i64 %i3
  %d1 = getelementptr inbounds i8, ptr %d0, i64 4
  %d2 = getelementptr inbounds i8, ptr %d0, i64 8
  store i32 %v0, ptr %d2, align 4
  store i32 %v1, ptr %d0, align 4
  store i32 %v2, ptr %d1, align 4
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %N
  br i1 %outer.ec, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}


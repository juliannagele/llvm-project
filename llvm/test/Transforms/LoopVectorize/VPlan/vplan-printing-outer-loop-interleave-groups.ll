; CHECK:      WIDEN store ir<%u1>, ir<%m1>, align 4
; CHECK:      WIDEN store ir<%v1>, ir<%m0>, align 4
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner ]
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %M
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %i2 = shl nsw i64 %i, 1
  %x0 = getelementptr inbounds i32, ptr %x, i64 %i2
  %x1 = getelementptr inbounds i8, ptr %x0, i64 4
  %y0 = getelementptr inbounds i32, ptr %y, i64 %i2
  %y1 = getelementptr inbounds i8, ptr %y0, i64 4
  %vx0 = load i32, ptr %x0, align 4
  %vy0 = load i32, ptr %y0, align 4
  %vx1 = load i32, ptr %x1, align 4
  %vy1 = load i32, ptr %y1, align 4
  %m0 = mul i32 %vx0, %vy0
  %m1 = mul i32 %vx1, %vy1
  %u0 = getelementptr inbounds i32, ptr %u, i64 %i2
  %u1 = getelementptr inbounds i8, ptr %u0, i64 4
  %v0 = getelementptr inbounds i32, ptr %v, i64 %i2
  %v1 = getelementptr inbounds i8, ptr %v0, i64 4
  store i32 %m0, ptr %u0, align 4
  store i32 %m1, ptr %v0, align 4
  store i32 %m1, ptr %u1, align 4

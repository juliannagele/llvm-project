; CHECK-NEXT:    [[TMP2:%.*]] = load i64, ptr [[PITCH_PTR]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = mul nsw i64 [[INDEX]], 3
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr inbounds i32, ptr [[TMP1]], i64 [[TMP3]]
; CHECK-NEXT:    br label %[[INNER1:.*]]
; CHECK:       [[INNER1]]:
; CHECK-NEXT:    [[J2:%.*]] = phi i64 [ 0, %[[VECTOR_BODY]] ], [ [[TMP13:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[A3:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP10:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[B4:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP11:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[C5:%.*]] = phi <4 x i32> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP12:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = mul nsw i64 [[J2]], [[TMP2]]
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds i32, ptr [[TMP4]], i64 [[TMP5]]
; CHECK-NEXT:    [[WIDE_VEC:%.*]] = load <12 x i32>, ptr [[TMP6]], align 4
; CHECK-NEXT:    [[STRIDED_VEC:%.*]] = shufflevector <12 x i32> [[WIDE_VEC]], <12 x i32> poison, <4 x i32> <i32 0, i32 3, i32 6, i32 9>
; CHECK-NEXT:    [[STRIDED_VEC6:%.*]] = shufflevector <12 x i32> [[WIDE_VEC]], <12 x i32> poison, <4 x i32> <i32 1, i32 4, i32 7, i32 10>
; CHECK-NEXT:    [[STRIDED_VEC7:%.*]] = shufflevector <12 x i32> [[WIDE_VEC]], <12 x i32> poison, <4 x i32> <i32 2, i32 5, i32 8, i32 11>
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds i32, ptr [[W]], i64 [[J2]]
; CHECK-NEXT:    [[TMP8:%.*]] = load i32, ptr [[TMP7]], align 4
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i32> poison, i32 [[TMP8]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i32> [[BROADCAST_SPLATINSERT]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP9:%.*]] = mul <4 x i32> [[STRIDED_VEC6]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP10]] = add <4 x i32> [[A3]], [[STRIDED_VEC]]
; CHECK-NEXT:    [[TMP11]] = add <4 x i32> [[B4]], [[TMP9]]
; CHECK-NEXT:    [[TMP12]] = add <4 x i32> [[C5]], [[STRIDED_VEC7]]
; CHECK-NEXT:    [[TMP13]] = add nuw nsw i64 [[J2]], 1
; CHECK-NEXT:    [[TMP14:%.*]] = icmp eq i64 [[TMP13]], [[M]]
; CHECK-NEXT:    br i1 [[TMP14]], label %[[OUTER_LATCH8]], label %[[INNER1]]
; CHECK:       [[OUTER_LATCH8]]:
; CHECK-NEXT:    [[TMP15:%.*]] = add <4 x i32> [[TMP10]], [[TMP11]]
; CHECK-NEXT:    [[TMP16:%.*]] = add <4 x i32> [[TMP15]], [[TMP12]]
; CHECK-NEXT:    [[TMP17:%.*]] = getelementptr inbounds i32, ptr [[DST]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x i32> [[TMP16]], ptr [[TMP17]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP18:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP18]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %src = load ptr, ptr %src.ptr, align 8
  %pitch = load i64, ptr %pitch.ptr, align 8
  %i3 = mul nsw i64 %i, 3
  %src.i = getelementptr inbounds i32, ptr %src, i64 %i3
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner ]
  %a = phi i32 [ 0, %outer.header ], [ %a.next, %inner ]
  %b = phi i32 [ 0, %outer.header ], [ %b.next, %inner ]
  %c = phi i32 [ 0, %outer.header ], [ %c.next, %inner ]
  %jp = mul nsw i64 %j, %pitch
  %p0 = getelementptr inbounds i32, ptr %src.i, i64 %jp
  %p1 = getelementptr inbounds i8, ptr %p0, i64 4
  %p2 = getelementptr inbounds i8, ptr %p0, i64 8
  %v0 = load i32, ptr %p0, align 4
  %w.j = getelementptr inbounds i32, ptr %w, i64 %j
  %wv = load i32, ptr %w.j, align 4
  %v1.l = load i32, ptr %p1, align 4
  %v1 = mul i32 %v1.l, %wv
  %v2 = load i32, ptr %p2, align 4
  %a.next = add i32 %a, %v0
  %b.next = add i32 %b, %v1
  %c.next = add i32 %c, %v2
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %M
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %ab = add i32 %a.next, %b.next
  %abc = add i32 %ab, %c.next
  %dst.i = getelementptr inbounds i32, ptr %dst, i64 %i
  store i32 %abc, ptr %dst.i, align 4
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %N
  br i1 %outer.ec, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}

!0 = distinct !{!0, !1, !3}
!1 = !{!"llvm.loop.vectorize.width", i32 4}
!2 = distinct !{!2, !1, !3, !4}
!3 = !{!"llvm.loop.vectorize.enable"}
!4 = !{!"llvm.loop.vectorize.scalable.enable"}

  store i32 %t, ptr %d1, align 4
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %N
  br i1 %outer.ec, label %exit, label %outer.header, !llvm.loop !0

exit:
  %s.last = add i64 %S, %i
  store i64 %s.last, ptr %out, align 8
  ret void
}


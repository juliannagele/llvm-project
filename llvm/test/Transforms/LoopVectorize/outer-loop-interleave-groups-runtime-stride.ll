; CHECK-NEXT:    br label %[[INNER1:.*]]
; CHECK:       [[INNER1]]:
; CHECK-NEXT:    [[J2:%.*]] = phi i64 [ 0, %[[VECTOR_BODY]] ], [ [[TMP1:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[TMP1]] = add nuw nsw i64 [[J2]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], [[M]]
; CHECK-NEXT:    br i1 [[TMP2]], label %[[OUTER_LATCH3]], label %[[INNER1]]
; CHECK:       [[OUTER_LATCH3]]:
; CHECK-NEXT:    [[TMP3:%.*]] = mul nsw <4 x i64> [[VEC_IND]], splat (i64 3)
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr inbounds [4 x i8], ptr [[DST]], <4 x i64> [[TMP3]]

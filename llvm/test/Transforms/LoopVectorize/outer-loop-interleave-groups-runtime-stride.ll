; A load group in the inner loop and a store group through a pointer induction
; with the same runtime stride, so one predicate covers both:
;   for (j = 0; j < M; j++) { p = &src[i * S + j * pitch]; a += p[0]; b += p[1]; c += p[2]; }
;   q[0] = a; q[1] = b; q[2] = c; q += S;
define void @load_and_store_groups_same_runtime_stride(ptr noalias %dst, ptr noalias %src, i32 %S, i64 %pitch, i64 %N, i64 %M) {
; CHECK-LABEL: define void @load_and_store_groups_same_runtime_stride(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]], i32 [[S:%.*]], i64 [[PITCH:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[S_EXT:%.*]] = sext i32 [[S]] to i64
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_SCEVCHECK:.*]]
; CHECK:       [[VECTOR_SCEVCHECK]]:
; CHECK-NEXT:    [[IDENT_CHECK:%.*]] = icmp ne i32 [[S]], 3
; CHECK-NEXT:    br i1 [[IDENT_CHECK]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = and i64 [[N]], 3
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP0]]
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[N_VEC]], 3
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP1]]
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[OUTER_LATCH8:.*]] ]
; CHECK-NEXT:    [[TMP3:%.*]] = mul i64 [[INDEX]], 3
; CHECK-NEXT:    [[NEXT_GEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP3]]
; CHECK-NEXT:    [[TMP4:%.*]] = mul nsw i64 [[INDEX]], 3
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr inbounds i8, ptr [[SRC]], i64 [[TMP4]]
; CHECK-NEXT:    br label %[[INNER1:.*]]
; CHECK:       [[INNER1]]:
; CHECK-NEXT:    [[J2:%.*]] = phi i64 [ 0, %[[VECTOR_BODY]] ], [ [[TMP11:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[A3:%.*]] = phi <4 x i8> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP8:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[B4:%.*]] = phi <4 x i8> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP9:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[C5:%.*]] = phi <4 x i8> [ zeroinitializer, %[[VECTOR_BODY]] ], [ [[TMP10:%.*]], %[[INNER1]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = mul nsw i64 [[J2]], [[PITCH]]
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds i8, ptr [[TMP5]], i64 [[TMP6]]
; CHECK-NEXT:    [[WIDE_VEC:%.*]] = load <12 x i8>, ptr [[TMP7]], align 1
; CHECK-NEXT:    [[STRIDED_VEC:%.*]] = shufflevector <12 x i8> [[WIDE_VEC]], <12 x i8> poison, <4 x i32> <i32 0, i32 3, i32 6, i32 9>
; CHECK-NEXT:    [[STRIDED_VEC6:%.*]] = shufflevector <12 x i8> [[WIDE_VEC]], <12 x i8> poison, <4 x i32> <i32 1, i32 4, i32 7, i32 10>
; CHECK-NEXT:    [[STRIDED_VEC7:%.*]] = shufflevector <12 x i8> [[WIDE_VEC]], <12 x i8> poison, <4 x i32> <i32 2, i32 5, i32 8, i32 11>
; CHECK-NEXT:    [[TMP8]] = add <4 x i8> [[A3]], [[STRIDED_VEC]]
; CHECK-NEXT:    [[TMP9]] = add <4 x i8> [[B4]], [[STRIDED_VEC6]]
; CHECK-NEXT:    [[TMP10]] = add <4 x i8> [[C5]], [[STRIDED_VEC7]]
; CHECK-NEXT:    [[TMP11]] = add nuw nsw i64 [[J2]], 1
; CHECK-NEXT:    [[TMP12:%.*]] = icmp eq i64 [[TMP11]], [[M]]
; CHECK-NEXT:    br i1 [[TMP12]], label %[[OUTER_LATCH8]], label %[[INNER1]]
; CHECK:       [[OUTER_LATCH8]]:
; CHECK-NEXT:    [[TMP13:%.*]] = shufflevector <4 x i8> [[TMP8]], <4 x i8> [[TMP9]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP14:%.*]] = shufflevector <4 x i8> [[TMP10]], <4 x i8> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 poison, i32 poison, i32 poison, i32 poison>
; CHECK-NEXT:    [[TMP15:%.*]] = shufflevector <8 x i8> [[TMP13]], <8 x i8> [[TMP14]], <12 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11>
; CHECK-NEXT:    [[INTERLEAVED_VEC:%.*]] = shufflevector <12 x i8> [[TMP15]], <12 x i8> poison, <12 x i32> <i32 0, i32 4, i32 8, i32 1, i32 5, i32 9, i32 2, i32 6, i32 10, i32 3, i32 7, i32 11>
; CHECK-NEXT:    store <12 x i8> [[INTERLEAVED_VEC]], ptr [[NEXT_GEP]], align 1
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP16:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP16]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP18:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  %S.ext = sext i32 %S to i64
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %ptr.iv = phi ptr [ %dst, %entry ], [ %ptr.iv.next, %outer.latch ]
  %iS = mul nsw i64 %i, %S.ext
  %src.i = getelementptr inbounds i8, ptr %src, i64 %iS
  br label %inner

inner:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner ]
  %a = phi i8 [ 0, %outer.header ], [ %a.next, %inner ]
  %b = phi i8 [ 0, %outer.header ], [ %b.next, %inner ]
  %c = phi i8 [ 0, %outer.header ], [ %c.next, %inner ]
  %jp = mul nsw i64 %j, %pitch
  %p0 = getelementptr inbounds i8, ptr %src.i, i64 %jp
  %p1 = getelementptr inbounds i8, ptr %p0, i64 1
  %p2 = getelementptr inbounds i8, ptr %p0, i64 2
  %v0 = load i8, ptr %p0, align 1
  %v1 = load i8, ptr %p1, align 1
  %v2 = load i8, ptr %p2, align 1
  %a.next = add i8 %a, %v0
  %b.next = add i8 %b, %v1
  %c.next = add i8 %c, %v2
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp eq i64 %j.next, %M
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %q1 = getelementptr inbounds i8, ptr %ptr.iv, i64 1
  %q2 = getelementptr inbounds i8, ptr %ptr.iv, i64 2
  store i8 %a.next, ptr %ptr.iv, align 1
  store i8 %b.next, ptr %q1, align 1
  store i8 %c.next, ptr %q2, align 1
  %ptr.iv.next = getelementptr inbounds i8, ptr %ptr.iv, i64 %S.ext
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp eq i64 %i.next, %N
  br i1 %outer.ec, label %exit, label %outer.header, !llvm.loop !0

exit:
  ret void
}


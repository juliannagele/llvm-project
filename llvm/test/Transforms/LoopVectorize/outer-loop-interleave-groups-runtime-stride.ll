; The loads at dst[i * S + 0..2] form a group of factor 3 if %S == 3. The load
; at dst[i * S + 5] is not part of the contiguous range of the group.
define void @load_group_runtime_stride_far_load(ptr noalias %dst, ptr noalias %out, i64 %S, i64 %N, i64 %M) {
; CHECK-LABEL: define void @load_group_runtime_stride_far_load(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[OUT:%.*]], i64 [[S:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_SCEVCHECK:.*]]
; CHECK:       [[VECTOR_SCEVCHECK]]:

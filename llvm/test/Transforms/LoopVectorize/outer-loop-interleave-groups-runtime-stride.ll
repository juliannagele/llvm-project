  %d0 = getelementptr inbounds i32, ptr %dst, i64 %iS
  %d1 = getelementptr inbounds i8, ptr %d0, i64 4
  %d2 = getelementptr inbounds i8, ptr %d0, i64 8
  %d5 = getelementptr inbounds i8, ptr %d0, i64 20
  %v0 = load i32, ptr %d0, align 4
  %v1 = load i32, ptr %d1, align 4
  %v2 = load i32, ptr %d2, align 4
  %v5 = load i32, ptr %d5, align 4
